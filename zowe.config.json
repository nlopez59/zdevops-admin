{
    "$schema": "./zowe.schema.json",
    "profiles": {
        "zos": {
            "type": "rse",
            "properties": {
                "port": <RSEAPI_PORT> 
            } 
        },
        
        "project_base": {
            "type": "base",
            "properties": {
                "protocol": "https",
                "rejectUnauthorized": false,
                "basePath": "rseapi",                                
                "host": "zos"
            },
            "secure": [
                "user",
                "password"
            ]
        }
    },
    "autoStore": true,
    "defaults": {
        "base": "project_base",
        "rse": "rse"
    }
}