{
    "$schema": "./zowe.schema.json",
    "Nelsons-Notes": [
        "- Use this to connect to zOS from VS Code using the RSEAPI (STC) for user IBMUSER and your password",                
        "- All ports and security have been pre-configured",
        "- Just change the IP of the HOST to your TAZ/ODE Host IP"
    ],
    "profiles": {
        "rse": {
            "type": "rse",
            "properties": {
                "port": 8195
            } 
        },
        
        "project_base": {
            "type": "base",
            "properties": {
                "protocol": "https",
                "rejectUnauthorized": false,
                "basePath": "rseapi",

                "COMMENT4": "Change the HOST IP below to your FRYE VM's public IP ",
                "host-baseline": "9.37.212.26",
                "host": "9.60.140.251"
            },
            "secure": [
                "user",
                "password"
            ]
        }
    },
    "autoStore": true,
    "defaults": {
        "base": "project_base",
        "rse": "rse"
    }
}